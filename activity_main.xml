<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FC"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0288D1"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔵 நம்ம ஊர் சேவை"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 குடியாத்தம்"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Box -->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:hint="🔍 உங்களுக்கு என்ன சேவை வேண்டும்?"
        android:padding="14dp"
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- Section Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="📂 அனைத்துத் தொழில்கள் &amp; சேவைகள்"
        android:textColor="#0288D1"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Button Row 1: Cooking & Tree Climbing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCooking"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FFFFFF"
            android:text="🍲\nசமையல் சேவைகள்"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTreeClimbing"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FFFFFF"
            android:text="🌴\nமரம் ஏறும் தொழில்கள்"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Button Row 2: Electrical & Construction -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnElectrical"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FFFFFF"
            android:text="⚡\nமின்சாரம் &amp; பிளம்பிங்"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConstruction"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FFFFFF"
            android:text="🧱\nகட்டிட வேலைகள்"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

